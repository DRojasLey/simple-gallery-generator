{
  "name": "simple-gallery-gen",
  "version": "2.0.1",
  "description": "Create simple HTML galleries generated from images in a folder, supporting jpg, png and bmp formats.",
  "main": "dist/cli.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/DRojasLey/simple-gallery-generator/"
  },
  "scripts": {
    "test": "\"echo \\\"Error: no test specified\\\" && exit 1\"",
    "createImageList": "node dist/cli.js lsimages",
    "copyImages": "node dist/cli.js  copyImages ",
    "createThumbnails": "node dist/cli.js thumbcreate imageIndex.json",
    "setFiles": "node dist/cli.js set-files",
    "setup": "node dist/cli.js setup",
    "build": "flow-remove-types src/ -d dist/"
  },
  "bin": {
    "simple-gallery-gen": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "gallery",
    "image_utils.js",
    "cli.js",
    "gallery_generator.js"
  ],
  "keywords": [
    "gallery",
    "HTML",
    "images",
    "png",
    "jpg",
    "bmp",
    "collection",
    "generation"
  ],
  "author": "dfrley",
  "license": "MIT",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.14.2",
    "commander": "^12.1.0",
    "fs": "^0.0.1-security",
    "path": "^0.12.7",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "flow-bin": "^0.250.0"
  }
}
